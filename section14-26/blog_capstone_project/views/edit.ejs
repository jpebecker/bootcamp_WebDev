<%- include('partials/header', { pageTitle: 'Edit Post: A Ride Everyday' }) %>

<div class="page-header">
  <h1>Edit Post</h1>
</div>

<% if (typeof error !== 'undefined') { %>
  <p class="form-error"><%= error %></p>
<% } %>

<form action="/posts/<%= post.id %>?_method=PUT" method="POST" class="post-form">
  <label for="carName">Car Model</label>
  <input type="text" id="carName" name="carName" value="<%= post.carName %>">

  <label for="carYear">Model Year</label>
  <input type="text" id="carYear" name="carYear" value="<%= post.carYear %>">

  <label for="title">Post Title</label>
  <input type="text" id="title" name="title" required value="<%= post.title %>">

  <label for="imageUrl">Car Image URL</label>
  <input type="url" id="imageUrl" name="imageUrl" value="<%= post.imageUrl %>">

  <label for="content">Post Content</label>
  <textarea id="content" name="content" rows="10" required><%= post.content %></textarea>

  <div class="form-actions">
    <a href="/posts/<%= post.id %>" class="btn btn-secondary">Cancel</a>
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </div>
</form>

<%- include('partials/footer') %>
